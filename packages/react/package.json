{
  "name": "@flowglyph/react",
  "version": "0.0.0",
  "description": "Thin React bindings for FlowGlyph.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts --clean --external react",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@flowglyph/core": "workspace:*",
    "react": ">=18.3.0"
  },
  "devDependencies": {
    "@flowglyph/core": "workspace:*",
    "@types/react": "^19.2.7",
    "react": "^19.2.5"
  }
}
