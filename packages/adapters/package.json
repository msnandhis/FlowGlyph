{
  "name": "@flowglyph/adapters",
  "version": "0.0.0",
  "description": "Lightweight stream adapters for FlowGlyph.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@flowglyph/core": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.5"
  }
}
