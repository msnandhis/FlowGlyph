{
  "name": "flowglyph-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.14.2",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "dev": "pnpm --filter flowglyph-playground dev",
    "test": "pnpm build && pnpm -r --filter './packages/**' test",
    "typecheck": "pnpm build && pnpm -r --filter './packages/**' typecheck",
    "pack:dry-run": "pnpm --filter flowglyph exec npm pack --dry-run",
    "publish:npm": "pnpm --filter flowglyph publish --access public --no-git-checks",
    "clean": "pnpm -r --filter './packages/**' clean && rm -rf apps/playground/dist"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
